    "server:local": "node server/dev.js"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "vite": "7.3.6"
  }
}
