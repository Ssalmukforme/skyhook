{
  "name": "skyhook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 0.0.0.0 --configLoader native",
    "test": "node --test tests/*.test.js",
    "dev:crazygames": "vite --host 0.0.0.0 --configLoader native --mode crazygames",
    "build:crazygames": "vite build --configLoader native --mode crazygames",
    "pack:crazygames": "npm run build:crazygames && node scripts/pack-crazygames.mjs",
    "dev:crazygames:full": "vite --host 0.0.0.0 --configLoader native --mode crazygames-full",
    "build:crazygames:full": "vite build --configLoader native --mode crazygames-full"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "vite": "7.3.6"
  }
}
