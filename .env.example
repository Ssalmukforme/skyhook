# Copy to .env and fill in. `npm start` reads it automatically.
DATABASE_URL=postgres://skyhook:change-me@localhost:5432/skyhook
# PGSSL=require           # when the database requires TLS
PORT=8787
HOST=0.0.0.0
# Behind nginx/Caddy: use X-Forwarded-For for per-IP rate limits.
TRUST_PROXY=false
# Only when the game page is served from a different origin than this API.
# CORS_ORIGIN=https://game.example.com
# Defaults to ./dist when it exists; set to "off" for API only.
# STATIC_DIR=/var/www/skyhook
